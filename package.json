{
  "name": "kalu-kumara-engine",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "sync-story": "tsx story-twine/scripts/compile-twee-to-json.ts",
    "generate-icons": "node scripts/generate-icons.js",
    "predev": "npm run sync-story",
    "dev": "vite",
    "prebuild": "npm run sync-story",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "preview": "vite preview",
    "cap:init": "npx cap add android",
    "cap:sync": "npm run build && npx cap sync android",
    "cap:open": "npx cap open android",
    "apk:debug": "npm run cap:sync && cd android && ./gradlew assembleDebug",
    "deploy": "npm run build && firebase deploy --only hosting"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/app": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/haptics": "^7.0.0",
    "@capacitor/splash-screen": "^7.0.0",
    "@capacitor/status-bar": "^7.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "~5.7.2",
    "vite": "^6.0.5",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^5.0.5"
  }
}
