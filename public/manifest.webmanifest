{
  "id": "com.aftermonsoon.kalukumara",
  "name": "After Monsoon · Kalu Kumara & The Samayam Anthology",
  "short_name": "Kalu Kumara",
  "description": "A five-casefile Sri Lankan folk-horror anthology of dusk taboos, betel-leaf divination, and midnight Thovil exorcism rituals.",
